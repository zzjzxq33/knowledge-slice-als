# 复制为 backend/.env 并按需填写
# ================= 服务 =================
HOST=127.0.0.1
PORT=5000
# FLASK_DEBUG=1
# CORS_ORIGINS=*

# ================= 存储 =================
# STORAGE_DIR=/path/to/storage
MAX_UPLOAD_MB=2048
WORKER_COUNT=2

# ================= 讯飞开放平台（语音听写）=================
# 控制台: https://console.xfyun.cn/  -> 创建应用 -> 语音听写（流式版）
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
# 每段音频最长秒数（接口每会话上限约 60s，长音频自动按静音点切分）
XFYUN_CHUNK_SECONDS=55
# 每发一帧(40ms)音频的等待秒数；0.01≈4倍速，调大更稳，0 为全速
XFYUN_FRAME_SLEEP=0.01

# ================= 腾讯云（录音文件识别）=================
# 控制台: https://console.cloud.tencent.com/asr -> 密钥: https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 分片上限秒数（每片转 mp3 约 1.2MB，低于接口 5MB 限制）
TENCENT_CHUNK_SECONDS=280
# 识别引擎: 16k_zh / 16k_zh_video / 16k_zh_large / 8k_zh
TENCENT_ENGINE=16k_zh
TENCENT_POLL_INTERVAL=1.5

# ================= 开发调试 =================
# 开启后前端可选“模拟转写”，无需任何密钥即可跑通全流程
ENABLE_MOCK_PROVIDER=0
